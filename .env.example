# Browser-facing mock UI listener.
CITIUS_UI_HOST=127.0.0.1
CITIUS_UI_PORT=7860

# Python SDK gRPC target. This is a target, not an HTTP URL.
CITIUS_ENDPOINT=localhost:50051
CITIUS_TLS_ENABLED=true
# Source citius-server/bootstrap/zitadel/citius-zitadel.env or set this to the
# CA path emitted there when using the local mkcert profile.
CITIUS_TLS_CA=
CITIUS_TLS_SERVER_NAME=localhost
CITIUS_REQUEST_TIMEOUT_SECONDS=10

# Non-secret output generated by citius-server/bootstrap/zitadel/setup-auth.
CITIUS_OIDC_CONFIG_PATH=../citius-server/bootstrap/zitadel/citius-ui-auth.json
# CA used to trust the Zitadel JWKS fetch during ID-token signature validation.
# Defaults to CITIUS_TLS_CA when unset; set explicitly if the issuer uses a
# different trust root than the gRPC endpoint.
CITIUS_OIDC_CA_CERT=

# Session and history limits. The future OIDC session secret is deliberately not
# represented with an example value and must come from deployment secret storage.
CITIUS_SESSION_COOKIE_NAME=citius_session
CITIUS_SESSION_COOKIE_SECURE=true
CITIUS_HISTORY_LIMIT=200
